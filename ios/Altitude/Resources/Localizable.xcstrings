    "onboarding_display_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold it up to the lens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举到镜头前面"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez-le face à l’objectif"
          }
        }
      }
    },
    "onboarding_display_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At a pass, a ridge, or camp, leave the screen on. The altitude sits in large type, so a friend photographing you still gets a number you can read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在山口、垭口、营地把屏幕亮着。海拔用大字停在画面中央，朋友用另一台手机拍你，数字依然清楚。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au col, sur une crête ou au camp, laissez l’écran allumé. L’altitude s’affiche en grand : un ami peut vous photographier et le chiffre reste lisible."
          }
        }
      }
    },
    "onboarding_msl_kicker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sea level"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海平面"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau de la mer"
          }
        }
      }
    },
    "onboarding_msl_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not the ellipsoid height"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是椭球高度"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas l’altitude ellipsoïdale"
          }
        }
      }
    },
    "onboarding_msl_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Satellites report height above the Earth ellipsoid. Maps and trail signs use height above sea level. The phone converts it. With a barometer the reading is steadier and quicker. No network needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卫星给出的是地球椭球上的高度。地图和路牌上的海拔相对海平面。手机会换算过来；有气压计时，读数更稳，反应也更快。不需要网络。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les satellites mesurent la hauteur au-dessus de l’ellipsoïde terrestre. Les cartes et les panneaux indiquent l’altitude par rapport à la mer. Le téléphone fait la conversion. Avec un baromètre, le chiffre est plus stable et réagit plus vite. Aucun réseau n’est nécessaire."
          }
        }
      }
    },
    "onboarding_photo_kicker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The print"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成片"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tirage"
          }
        }
      }
    },
    "onboarding_photo_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written into the photo, not pasted on a screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写进照片，而不是贴在截图上"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscrit dans la photo, pas collé sur une capture"
          }
        }
      }
    },
    "onboarding_photo_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you take a picture, altitude, coordinates, and time are drawn into the frame as a footer, matching the viewfinder, and stored in the photo location data. The album is Pictures/Altitude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照时，海拔、经纬度和时间按底栏水印画进成片，和取景时看到的是同一套排版，并写入照片的位置信息。相册目录是 Pictures/Altitude。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la prise de vue, l’altitude, les coordonnées et l’heure sont dessinées dans l’image, avec la même mise en page que le viseur, et enregistrées dans les données de localisation. L’album est Pictures/Altitude."
          }
        }
      }
    },
