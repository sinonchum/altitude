    "searching_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step into the open and give the antenna some sky. The first fix can take a minute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走到空旷处，把天空让给天线。第一颗星有时要一分钟。"
          }
        },
        "fr": {
