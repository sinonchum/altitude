    "prompt_location_permission_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is not allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有定位权限"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position n’est pas autorisée"
          }
        }
      }
    },
    "prompt_location_permission_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude comes from satellites. Once you allow location, the number starts to follow you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海拔离不开卫星。授权之后，数字会开始跟着你走。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altitude vient des satellites. Une fois la position autorisée, le chiffre vous suit."
          }
        }
      }
    },
    "prompt_location_permission_action": {
      "extractionState": "manual",
