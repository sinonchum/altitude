    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude uses the camera to write elevation and coordinates into the photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude 使用相机，把海拔和经纬度写进照片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude utilise l’appareil photo pour inscrire l’altitude et les coordonnées dans la photo."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude uses your location so the altitude can follow you, including precise satellite height."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude 使用你的位置，让海拔跟着你走，包括精确的卫星高度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude utilise votre position pour que l’altitude vous suive, y compris la hauteur satellite précise."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude reads the photos it saved in the Altitude album so you can view them in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude 读取它保存在 Altitude 相册里的照片，方便你在应用内查看。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude lit les photos enregistrées dans l’album Altitude pour que vous puissiez les voir dans l’app."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude saves photos with the altitude watermark into your library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude 把带海拔水印的照片保存到你的照片图库。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude enregistre dans votre photothèque les photos portant le filigrane d’altitude."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude uses the barometer to steady the altitude between satellite fixes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude 使用气压计，在两次卫星定位之间稳住海拔。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude utilise le baromètre pour stabiliser l’altitude entre deux fixes satellite."
          }
        }
      }
    }
  }
}
