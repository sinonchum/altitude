    "settings_watermark_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watermark always includes altitude, coordinates, and time. You can hide coordinates on the display so a photo of the screen stays uncluttered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水印始终带上海拔、经纬度和时间。亮屏上的坐标可以单独关掉，避免拍屏幕时太满。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filigrane indique toujours l’altitude, les coordonnées et l’heure. Vous pouvez masquer les coordonnées sur l’écran pour qu’une photo de celui-ci reste lisible."
          }
        }
      }
    },
