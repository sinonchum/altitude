    <string name="onboarding_display_kicker">Display</string>
    <string name="onboarding_display_title">Hold it up to the lens</string>
    <string name="onboarding_display_body">At a pass, a ridge, or camp, leave the screen on. The altitude sits in large type, so a friend photographing you still gets a number you can read.</string>
    <string name="onboarding_msl_kicker">Sea level</string>
    <string name="onboarding_msl_title">Not the ellipsoid height</string>
    <string name="onboarding_msl_body">Satellites report height above the Earth ellipsoid. Maps and trail signs use height above sea level. The phone converts it. With a barometer the reading is steadier and quicker. No network needed.</string>
    <string name="onboarding_photo_kicker">The print</string>
    <string name="onboarding_photo_title">Written into the photo, not pasted on a screenshot</string>
    <string name="onboarding_photo_body">When you take a picture, altitude, coordinates, and time are drawn into the frame as a footer, matching the viewfinder, and stored in the photo location data. The album is Pictures/Altitude.</string>
